{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "radar-ia-api",
  "main": "google-tts-worker.js",
  "compatibility_date": "2026-11-19",
  // Preserve dashboard-managed variables and secrets during Wrangler deployments.
  // EDGE_TTS_API_KEY must remain a Secret in Cloudflare, not a plaintext vars entry.
  "keep_vars": true,
  "vars": {
    "AI_API_URL": "https://api.groq.com/openai/v1/chat/completions",
    "AI_MODEL": "llama-3.3-70b-versatile",
    "RSS_FEEDS": "https://openai.com/news/rss.xml\\nhttps://deepmind.google/blog/rss.xml\\nhttps://techcrunch.com/category/artificial-intelligence/feed/\\nhttps://www.theverge.com/rss/ai-artificial-intelligence/index.xml\\nhttps://www.technologyreview.com/topic/artificial-intelligence/feed\\nhttps://arstechnica.com/ai/feed/\\nhttps://huggingface.co/blog/feed.xml\\nhttps://blogs.nvidia.com/feed/"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "radar-ia-db",
      "database_id": "7c10231c-7142-46c9-9bca-a13012edbd53"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "TTS_KV",
      "id": "e25b3ba7c35540c1a00d8243596df88f"
    }
  ]
}
